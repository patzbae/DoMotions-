# ─── Logs ───────────────────────────────────────────────
# Keep the logs/ directory (via .gitkeep) but ignore actual log output.
logs/*
!logs/.gitkeep
*.log

# ─── OS / Editor cruft ──────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
.DS_Store?
._*

# ─── IDE ────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.swp

# ─── Node (in case tooling is added later) ──────────────
node_modules/
npm-debug.log*

# ─── Build / temp ───────────────────────────────────────
*.tmp
*.bak.tmp
dist/
build/

# ─── Custom Exclusions ──────────────────────────────────
.claude
error report/
docs/
