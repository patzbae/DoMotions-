<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	Version="5.0"
	ExtensionBundleId="com.rendertom.flow"
	ExtensionBundleVersion="1.4.2"
	ExtensionBundleName="Flow">

	<ExtensionList>
		<Extension Id="com.rendertom.flow" Version="1.4.2" />
		<Extension Id="com.aescripts.flow.about" Version="1.4.2" />
		<Extension Id="com.aescripts.flow.preferences" Version="1.4.2" />
	</ExtensionList>

	<ExecutionEnvironment>
		<HostList>
			<Host Name="AEFT" Version="[13.5,99.9]" />
		</HostList>
		<LocaleList>
			<Locale Code="All"/>
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="6.0"/>
		</RequiredRuntimeList>
	</ExecutionEnvironment>

	<DispatchInfoList>
		<Extension Id="com.rendertom.flow">
			<DispatchInfo>
				<Resources>
					<MainPath>./panel/index.html</MainPath>
					<ScriptPath>./panel/jsx/main.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--v=0</Parameter>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>Flow</Menu>
					<Geometry>
						<Size>
							<Height>974</Height>
							<Width>221</Width>
						</Size>
						<MinSize>
							<Height>517</Height>
							<Width>221</Width>
						</MinSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>

		<Extension Id="com.aescripts.flow.preferences">
			<DispatchInfo >
				<Resources>
					<MainPath>./preferences/preferences.html</MainPath>
					<CEFCommandLine>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--allow-file-access-from-files</Parameter>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<!-- Options panel is ALWAYS a dialog -->
					<Type>ModalDialog</Type>
					<Geometry>
						<Size>
							<Width>350</Width>
							<Height>475</Height>
						</Size>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>

		<Extension Id="com.aescripts.flow.about">
			<DispatchInfo >
				<Resources>
					<MainPath>./dialog/dialog.html</MainPath>
					<CEFCommandLine>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--allow-file-access-from-files</Parameter>
						<Parameter>--allow-file-access</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Modeless</Type>
					<Geometry>
						<Size>
							<Height>440</Height>
							<Width>350</Width>
						</Size>
						<MaxSize>
							<Height>500</Height>
							<Width>350</Width>
						</MaxSize>
						<MinSize>
							<Height>100</Height>
							<Width>350</Width>
						</MinSize>
					</Geometry>
				</UI>
			</DispatchInfo>
			</Extension>
	</DispatchInfoList>
</ExtensionManifest>
